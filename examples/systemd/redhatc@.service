[Unit]
Description=Redhat Client Service
After=network.target

[Service]
Type=simple
Restart=on-failure
RestartSec=5s
LimitNOFILE=1048576

# with root
ExecStart=/usr/bin/redhat -c /etc/redhat/%i.toml
# without root
# ExecStart=%h/.local/bin/redhat -c %h/.local/etc/redhat/%i.toml

[Install]
WantedBy=multi-user.target
