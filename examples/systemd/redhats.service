[Unit]
Description=Redhat Server Service
After=network.target

[Service]
Type=simple
Restart=on-failure
RestartSec=5s
LimitNOFILE=1048576

# with root
ExecStart=/usr/bin/redhat -s /etc/redhat/redhat.toml
# without root
# ExecStart=%h/.local/bin/redhat -s %h/.local/etc/redhat/redhat.toml

[Install]
WantedBy=multi-user.target
